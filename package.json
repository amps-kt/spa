{
  "name": "amps",
  "version": "2.1.0",
  "type": "module",
  "private": true,
  "prisma": {
    "schema": "./prisma/schema"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:debug": "next dev 2>&1 | grep --line-buffered '\\[DEBUG\\]'",
    "dev:db": "docker compose --env-file=./.env -f ./docker/docker-compose.dev-db.yml up -d",
    "dev:db+match": "docker compose --env-file=./.env -f ./docker/docker-compose.dev.yml up -d",
    "pull:db+match": "docker compose --env-file=./.env -f ./docker/docker-compose.dev.yml pull",
    "dev:test-image": "docker compose --env-file=./.env -f ./docker/docker-compose.dev-test-image.yml up --build app",
    "dev:email": "dotenvx run -- email dev --dir ./src/emails/messages -p 3001",
    "build:email": "dotenvx run -- email build --dir ./src/emails/messages",
    "start:email": "dotenvx run -- email start",
    "build": "next build",
    "start": "next start",
    "start:prod": "prisma migrate deploy && node server.js",
    "lint": "eslint",
    "lint:errs": "eslint --quiet",
    "audit:fixes": "node scripts/suggest-pnpm-overrides.js",
    "tc": "tsc",
    "test": "vitest",
    "postinstall": "prisma generate --no-hints",
    "db:generate": "prisma generate",
    "db:generate-push": "pnpm run db:generate && pnpm run db:push",
    "db:studio": "prisma studio",
    "db:migrate": "eval $(grep '^DATABASE_URL' .env) && prisma migrate dev",
    "db:push": "eval $(grep '^DATABASE_URL' .env) && prisma db push",
    "db:drop": "eval $(grep '^DATABASE_URL' .env) && prisma migrate reset",
    "check": "pnpm lint:errs && pnpm tc",
    "clearLogs": "rm *.log",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": "prettier --write"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.6.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-email/components": "0.0.36",
    "@react-email/render": "^1.4.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
