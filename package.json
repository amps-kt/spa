    "@trpc/server": "11.18.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@uiw/react-md-editor": "^4.1.1",
    "axios": "^1.19.0",
    "bullmq": "^5.81.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0",
    "embla-carousel-react": "^8.6.0",
    "immer": "^10.2.0",
    "ioredis": "^5.11.1",
    "lucide-react": "^0.537.0",
    "next": "16.2.12",
    "nodemailer": "^6.10.1",
